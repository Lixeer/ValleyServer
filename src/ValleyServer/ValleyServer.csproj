<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
  
  <Content Include="Content\**\*.*" >
    
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    
    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
  </Content>
</ItemGroup>
  <ItemGroup>
    <Reference Include="Lidgren.Network">
      <HintPath>deps\Lidgren.Network.dll</HintPath>
    </Reference>
    <Reference Include="MonoGame.Framework">
      <HintPath>deps\MonoGame.Framework.dll</HintPath>
    </Reference>
    <Reference Include="xTile">
      <HintPath>deps\xTile.dll</HintPath>
    </Reference>
    <Reference Include="StardewValley.GameData">
      <HintPath>deps\StardewValley.GameData.dll</HintPath>
    </Reference>
    <Reference Include="Stardew Valley">
      <HintPath>deps\Stardew Valley.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!--
    Stardew Valley.dll is a direct file reference, so MSBuild can't reliably discover
    all of its managed and native runtime dependencies. Ship every non-reference DLL
    from deps beside the server executable; this keeps published builds independent
    from VALLEY_GAME_PATH and from a local Stardew Valley installation.
  -->
  <ItemGroup>
    <None Include="deps\*.dll"
          Exclude="deps\Lidgren.Network.dll;deps\MonoGame.Framework.dll;deps\xTile.dll;deps\StardewValley.GameData.dll;deps\Stardew Valley.dll">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="deps\*.so;deps\*.so.*">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>

